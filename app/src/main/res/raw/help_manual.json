      "Instruction": "INT",
      "Syntax": "INT interrupt-number",
      "Description": "Calls interrupt 21h, the DOS service dispatcher. Supported services: AH=1 read a character into AL, AH=2 write the character in DL, AH=9 print the '$'-terminated string at DS:DX, AH=4Ch terminate the program.",
      "Source": ["AH (service number)"],
      "Destination": ["AL", "Output"],
      "FlagsChanged": [],
      "Examples": [
        {"Type":"Read character","Specimen":"MOV AH,1 \n INT 21H"},
        {"Type":"Write character","Specimen":"MOV AH,2 \n MOV DL,35H \n INT 21H"},
        {"Type":"Print string","Specimen":"MOV DX,200H \n MOV AH,9 \n INT 21H"},
        {"Type":"Exit","Specimen":"MOV AH,4CH \n INT 21H"}
      ]
    },
